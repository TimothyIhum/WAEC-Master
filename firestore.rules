rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safe Catch-all Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin(email) {
      return email.toLowerCase() == 'temiokusami@gmail.com' || email.toLowerCase() == 'timothyihum@gmail.com' || email.toLowerCase() == 'admin@waecmaster.edu.ng';
    }

    // 1. Users collection
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() || request.auth == null;
      allow delete: if false;
    }

    // 2. Discussions collection
    match /discussions/{discussionId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() || request.auth == null;
      allow delete: if isSignedIn() || request.auth == null;
    }

    // 3. Questions collection
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() || request.auth == null;
      allow delete: if false;
    }
  }
}
